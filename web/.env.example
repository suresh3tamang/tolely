# Copy to .env.local and fill in from Firebase console.

# Server (Admin SDK): Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Browser (admin dashboard login): Project settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Book by voice works for free without this (word rules). Optional: a Claude API key from
# https://platform.claude.com lets it understand freer sentences (paid per request).
# ANTHROPIC_API_KEY=

# Place search: identify the app to OpenStreetMap (use a real contact address in production).
# PLACES_USER_AGENT=Tolely/1.0 (contact@your-domain.com)

# Local testing with Firebase emulators (no real project needed):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_USE_EMULATORS=true
