<?xml version="1.0" encoding="utf-8"?>
<!-- Testing only: lets the app talk to the backend on this Mac over the local
     Wi-Fi without HTTPS. Remove the domain-config once the backend is
     deployed with HTTPS. Everything else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.101</domain>
        <domain includeSubdomains="false">192.168.1.75</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
